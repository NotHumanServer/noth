# Noth が読む秘密情報の一覧。
# リポジトリ直下には置かず、$NOTH_HOME/.env(既定 ~/.noth/.env)にコピーして権限を 600 にする。
#   cp .env.example ~/.noth/.env && chmod 600 ~/.noth/.env
# `noth init` を使えば、有効にした module に必要な行だけを書いた .env を作る。
# config.toml から `${VAR}` で参照されたものだけが使われ、プロセスの環境変数には入らない。

# channel-discord
DISCORD_BOT_TOKEN=

# router-systemone の preset = "jev"(TypeSafe)
TYPESAFE_API_KEY=
# preset = "clef"(Cloudflare Workers AI)を使う場合は上の行の代わりにこちら
# CF_API_TOKEN=
# CF_ACCOUNT_ID=

# provider は1つだけ有効にするので、使うものだけを埋める
# provider-anthropic
ANTHROPIC_API_KEY=
# provider-openai(preset = "codex" はキー不要。`noth auth codex` でログインする)
# OPENAI_API_KEY=
# provider-openai の preset = "opencode-go"
# OPENCODE_GO_API_KEY=
# provider-google(AI Studio)
# GOOGLE_AI_STUDIO_API_KEY=
# provider-google(Vertex)。サービスアカウント JSON のパス
# GOOGLE_APPLICATION_CREDENTIALS=

# tool-web-search / tool-web-fetch / tool-web-agent の backend
TINYFISH_API_KEY=
